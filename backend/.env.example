# PRAMAAN's own persistent database. Backend only.
NODE_ENV=development
MONGODB_URI=

# Portfolio REST connector. Set in backend/.env only.
PORTFOLIO_INQUIRIES_API_URL=http://localhost:3000/api/integrations/pramaan/inquiries
PRAMAAN_INTEGRATION_TOKEN=

# Optional allow-listed custom REST API hosts (comma-separated hostnames, no schemes).
REST_API_ALLOWED_HOSTS=api.example.com

# Optional server-only authentication profiles consumed by the REST API connector.
# Configure real values in backend/.env or the deployment secret store, never here.
REST_API_AUTH_PROFILES_JSON={}

# Optional direct MongoDB recipient source. Separate from MONGODB_URI; backend only.
EXTERNAL_MONGODB_URI=
